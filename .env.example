# Copy to .env and fill in whichever sources you want. Everything is optional:
# Bluesky, Hacker News and RSS work with no keys.

PORT=3000
# The address you open iweb at. OAuth redirect URIs are built from it, so they
# must be registered exactly as <BASE_URL>/auth/youtube/callback and /auth/reddit/callback.
# BASE_URL=http://localhost:3000

# --- Sign in with Google (imports your YouTube subscriptions) ---
# https://console.cloud.google.com/apis/credentials → OAuth client ID → "Web application"
# Authorized redirect URI: http://localhost:3000/auth/youtube/callback
# Enable "YouTube Data API v3" in the same project, and add yourself as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API key: only needed if you DON'T sign in with Google
# (to fetch listed channels / discovery anonymously).
YOUTUBE_API_KEY=

# --- Sign in with Reddit (imports your home feed) ---
# https://www.reddit.com/prefs/apps → create app → type "web app"
# Redirect URI: http://localhost:3000/auth/reddit/callback
# The same credentials also give non-signed-in access to the API (no RSS rate limits).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# X (Twitter) API v2 bearer token. Reading posts requires a paid X developer plan.
# https://developer.x.com/en/portal/dashboard
X_BEARER_TOKEN=

# Instagram Graph API: a long-lived token for an Instagram professional account,
# plus that account's IG user id. Lets you read other public Business/Creator accounts.
# https://developers.facebook.com/docs/instagram-platform
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v23.0
